# Frontend (public values only — these reach the browser)
VITE_SUPABASE_URL=https://bsqyycgmbumpfvjghstu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_k9N02FHgX8xDAnJvgPgvyw__cteELpo
# Optional: epoch (seconds) the looping live broadcast is anchored to. Must match the LIVE_EPOCH Edge Function secret if set.
VITE_LIVE_EPOCH=1793491200
# Optional: WebRTC ICE servers for video calls, as JSON. Defaults to Google's public STUN.
# Add a TURN server so calls connect on strict networks (corporate Wi-Fi, some mobile carriers), e.g.:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:443?transport=tcp","username":"user","credential":"pass"}]
VITE_ICE_SERVERS=

# (Older projects can use VITE_SUPABASE_ANON_KEY instead of VITE_SUPABASE_PUBLISHABLE_KEY.)

# Edge Function secrets — never here. Put them in supabase/functions/.env (gitignored) and run
# `supabase secrets set --env-file supabase/functions/.env`:
#   AI_PROVIDER=gemini                     (or anthropic; defaults to gemini when GEMINI_API_KEY is set)
#   GEMINI_API_KEY=
#   GEMINI_MODEL=gemini-3.5-flash
#   GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
#   ANTHROPIC_API_KEY=                     (when using Claude)
#   GAFFER_MODEL=claude-haiku-5-5          (Claude model)
#   LIVE_EPOCH=1793491200                  (optional, must match VITE_LIVE_EPOCH)

# Seed script — put these in supabase/seed/.env (local only):
#   SUPABASE_URL=
#   SUPABASE_SERVICE_ROLE_KEY=             (or a secret key, sb_secret_…)
